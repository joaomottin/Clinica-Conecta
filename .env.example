# Banco isolado do Supabase. Deixe ambos vazios para usar o repositório em memória somente em desenvolvimento.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gere valores longos, aleatórios e diferentes para cada segredo antes de publicar.
APP_SIGNING_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
ADMIN_PASSWORD=troque-por-uma-senha-administrativa-forte
ADMIN_SESSION_SECRET=troque-por-outro-segredo-aleatorio-com-pelo-menos-32-caracteres

# URL canônica da implantação, sem barra no fim.
SITE_URL=http://localhost:3000

# Este MVP fictício deve permanecer fora de mecanismos de busca.
ALLOW_SEARCH_INDEXING=false
